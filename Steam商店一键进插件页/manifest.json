{
  "manifest_version": 3,
  "name": "Steam 商店一键进插件管理页",
  "version": "1.0.0",
  "key": "",
  "description": "在 Steam 商店页面（含 Steam 客户端内置浏览器）加一个悬浮按钮，点一下直接跳到 chrome://extensions 插件管理页。",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "一键打开插件管理页 (chrome://extensions)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://store.steampowered.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
